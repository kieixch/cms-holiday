# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/holiday_banyuwangi?schema=public"
# Koneksi langsung tanpa pooler, dipakai HANYA untuk migrasi (Neon/Supabase
# punya host pooler terpisah untuk aplikasi). Di dev, samakan dengan DATABASE_URL.
DIRECT_URL=""

# --- Auth ---
AUTH_SECRET="ganti-dengan-random-string-minimal-32-karakter"

# --- Website ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Basis URL untuk audit markup/baseline (opsional; default NEXT_PUBLIC_SITE_URL).
AUDIT_BASE_URL="http://localhost:3000"

# --- Instagram feed (opsional; Meta Graph API) ---
# Id pengguna Instagram Business/Creator yang terhubung ke Facebook Page —
# didapat dari Graph API Explorer (GET /{ig-user-id}/media?fields=...).
IG_USER_ID=""
# Token akses jangka panjang (±60 hari) untuk akun tersebut.
IG_ACCESS_TOKEN=""
# Kosongkan keduanya: seksi Feed Instagram tetap tampil (kepala + baris brand),
# hanya grid postingan dan tombol "Muat Lebih Banyak" yang tidak muncul.

# --- Storage: "local" (default, untuk dev/VPS) atau "s3" (Cloudflare R2 / Vercel Blob / AWS) ---
STORAGE_DRIVER="local"

# Path untuk driver "local". Harus DI LUAR public/ karena Next.js mem-foto
# isi public/ saat build, jadi file yang diunggah setelah build tidak tersaji.
STORAGE_LOCAL_PATH="./storage/uploads"
# Base URL publik untuk driver "local"
STORAGE_PUBLIC_URL="/uploads"

# Hanya dipakai saat STORAGE_DRIVER="s3"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Admin bootstrap (dipakai oleh scripts/import-content.ts) ---
ADMIN_EMAIL="admin@holidaybanyuwangi.com"
ADMIN_PASSWORD="ganti-password-ini"

# --- Scripts QA (JANGAN hardcode di kode) ---
# Password akun admin untuk scripts/test-admin-login.ts.
ADMIN_TEST_PASSWORD=""
# Kandidat password lama untuk scripts/check-admin.ts (opsional).
ADMIN_LEGACY_PASSWORD=""