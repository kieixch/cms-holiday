{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/import-content.ts",
    "db:seed-bio": "tsx scripts/seed-bio.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:studio": "prisma studio",
    "extract": "tsx scripts/extract-content.ts",
    "content:export": "tsx scripts/export-content.ts",
    "css": "node scripts/extract-css.mjs && node scripts/merge-css.mjs",
    "prepare:content": "pnpm extract && pnpm css",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "setup": "pnpm db:up && prisma generate && prisma migrate deploy && tsx scripts/import-content.ts",
    "db:reset": "prisma migrate reset --force && tsx scripts/import-content.ts",
    "audit:markup": "node scripts/audit-markup.mjs",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "test:image": "tsx scripts/test-image.ts",
    "test:fields": "tsx scripts/test-fields.ts",
    "test:category": "tsx scripts/test-category-form.ts",
    "test:package": "tsx scripts/test-package-form.ts",
    "test:login": "tsx scripts/test-admin-login.ts",
    "admin:check": "tsx scripts/check-admin.ts",
    "test:crop": "tsx scripts/test-crop.ts",
    "test:gallery": "tsx scripts/test-gallery.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.6"
}
